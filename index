          currentMembers.length > 0
        ) {

          selectedMemberId =
            currentMembers[0].id;


          localStorage.setItem(
            memberStorageKey,
            selectedMemberId
          );
        }


        if (
          !selectedMemberId
        ) {

          showToast(
            '入力者を選択してください'
          );

          return;
        }


        const btn =
          document.getElementById(
            'submit-btn'
          );


        btn.disabled =
          true;


        let uploadedImage =
          null;


        try {

          if (
            currentImageBlob
          ) {

            showToast(
              '画像をアップロード中...'
            );


            uploadedImage =
              await uploadImage(
                currentImageBlob
              );
          }


          const newItem = {

            text,

            memberId:
              selectedMemberId,

            completed:
              false,

            createdAt:
              Date.now(),

            imageUrl:
              uploadedImage
                ? uploadedImage.downloadUrl
                : null,

            storagePath:
              uploadedImage
                ? uploadedImage.storagePath
                : null

          };


          await addDoc(
            getListCol(),
            newItem
          );


          inputEl.value =
            '';


          clearImagePreview();


          setTimeout(
            () => {

              const container =
                document.getElementById(
                  'list-container'
                );


              container.scrollTop =
                container.scrollHeight;

            },
            100
          );

        }
        catch (error) {

          console.error(
            'Add item error:',
            error
          );


          /*
           * Storageへのアップロードだけ成功し、
           * Firestore追加に失敗した場合は
           * 孤立画像を削除する
           */
          if (
            uploadedImage?.storagePath
          ) {

            try {

              await deleteObject(
                ref(
                  storage,
                  uploadedImage.storagePath
                )
              );

            }
            catch {
              // 削除失敗は無視
            }
          }


          if (
            error?.code ===
            'storage/unauthorized'
          ) {

            showToast(
              '画像保存の権限がありません'
            );

          }
          else {

            showToast(
              `追加に失敗しました ${
                error?.code || ''
              }`
            );
          }

        }
        finally {

          btn.disabled =
            false;
        }
      };


    /* =========================================================
       画像選択
    ========================================================= */

    document
      .getElementById(
        'trigger-image-btn'
      )
      .onclick =
      () => {

        document
          .getElementById(
            'image-input'
          )
          .click();
      };


    document
      .getElementById(
        'image-input'
      )
      .onchange =
      async event => {

        const file =
          event.target.files?.[0];


        if (!file) {
          return;
        }


        if (
          !file.type.startsWith(
            'image/'
          )
        ) {

          showToast(
            '画像ファイルを選択してください'
          );

          event.target.value =
            '';

          return;
        }


        showToast(
          '画像を処理中...'
        );


        try {

          const blob =
            await resizeImage(
              file
            );


          currentImageBlob =
            blob;


          if (
            currentImagePreviewUrl
          ) {

            URL.revokeObjectURL(
              currentImagePreviewUrl
            );
          }


          currentImagePreviewUrl =
            URL.createObjectURL(
              blob
            );


          document
            .getElementById(
              'image-preview'
            )
            .src =
            currentImagePreviewUrl;


          document
            .getElementById(
              'image-preview-container'
            )
            .classList
            .remove(
              'hidden'
            );

        }
        catch (error) {

          console.error(
            error
          );


          showToast(
            '画像の読み込みに失敗しました'
          );
        }


        event.target.value =
          '';
      };


    const clearImagePreview =
      () => {

        currentImageBlob =
          null;


        if (
          currentImagePreviewUrl
        ) {

          URL.revokeObjectURL(
            currentImagePreviewUrl
          );


          currentImagePreviewUrl =
            null;
        }


        document
          .getElementById(
            'image-preview-container'
          )
          .classList
          .add(
            'hidden'
          );


        document
          .getElementById(
            'image-preview'
          )
          .src =
          '';
      };


    document
      .getElementById(
        'remove-image-btn'
      )
      .onclick =
      clearImagePreview;


    /* =========================================================
       設定
    ========================================================= */

    document
      .getElementById(
        'open-settings-btn'
      )
      .onclick =
      () => {

        renderColorPalette();


        document
          .getElementById(
            'settings-modal'
          )
          .classList
          .remove(
            'hidden'
          );
      };


    document
      .getElementById(
        'close-settings'
      )
      .onclick =
      () => {

        document
          .getElementById(
            'settings-modal'
          )
          .classList
          .add(
            'hidden'
          );
      };


    /* =========================================================
       メンバー追加
    ========================================================= */

    document
      .getElementById(
        'add-member-btn'
      )
      .onclick =
      async () => {

        if (
          !auth.currentUser
        ) {
          return;
        }


        const input =
          document.getElementById(
            'new-member-name'
          );


        const name =
          input.value.trim();


        if (!name) {
          return;
        }


        const newOrder =
          currentMembers.length;


        try {

          const ref =
            await addDoc(
              getMembersCol(),
              {

                name,

                colorIndex:
                  selectedColorIndex,

                order:
                  newOrder,

                createdAt:
                  Date.now()

              }
            );


          input.value =
            '';


          selectedMemberId =
            ref.id;


          localStorage.setItem(
            memberStorageKey,
            ref.id
          );


          showToast(
            '入力者を追加しました'
          );

        }
        catch (error) {

          console.error(
            error
          );


          showToast(
            '追加に失敗しました'
          );
        }
      };


    /* =========================================================
       共有URL
    ========================================================= */

    document
      .getElementById(
        'copy-url-btn'
      )
      .onclick =
      async () => {

        const url =
          window.location.protocol +
          "//" +
          window.location.host +
          window.location.pathname +
          '?uid=' +
          encodeURIComponent(
            shareId
          );


        try {

          if (
            navigator.share
          ) {

            await navigator.share({
              title:
                '家族のお買い物メモ',

              url
            });


            return;
          }


          if (
            navigator.clipboard
          ) {

            await navigator
              .clipboard
              .writeText(
                url
              );


            showToast(
              '招待URLをコピーしました！'
            );


            return;
          }

        }
        catch (error) {

          if (
            error?.name ===
            'AbortError'
          ) {
            return;
          }
        }


        const textArea =
          document.createElement(
            'textarea'
          );


        textArea.value =
          url;


        textArea.style.position =
          'fixed';


        textArea.style.left =
          '-9999px';


        document.body.appendChild(
          textArea
        );


        textArea.focus();
        textArea.select();


        try {

          document.execCommand(
            'copy'
          );


          showToast(
            '招待URLをコピーしました！'
          );

        }
        catch {

          prompt(
            '以下のURLをコピーしてください',
            url
          );
        }


        document.body.removeChild(
          textArea
        );
      };


    /* =========================================================
       画像モーダル
    ========================================================= */

    document
      .getElementById(
        'image-modal'
      )
      .onclick =
      event => {

        if (
          event.target.id ===
            'image-modal' ||

          event.target.id ===
            'close-image-modal' ||

          event.target.closest(
            '#close-image-modal'
          )
        ) {

          const modal =
            document.getElementById(
              'image-modal'
            );


          modal.classList.add(
            'opacity-0'
          );


          setTimeout(
            () => {

              modal.classList.add(
                'hidden'
              );


              document
                .getElementById(
                  'expanded-image'
                )
                .src =
                '';

            },
            300
          );
        }
      };


    /* =========================================================
       Firebase初期化
    ========================================================= */

    const init =
      async () => {

        lucide.createIcons();


        try {

          await setPersistence(
            auth,
            browserLocalPersistence
          );


          if (
            !auth.currentUser
          ) {

            await signInAnonymously(
              auth
            );
          }

        }
        catch (error) {

          console.error(
            'Auth error:',
            error
          );


          showToast(
            `認証エラー: ${
              error?.code || ''
            }`
          );


          const loader =
            document.getElementById(
              'initial-loading'
            );


          if (loader) {

            loader.innerHTML = `
              <div class="text-center px-6">
                <p class="text-red-500 text-xs font-bold">
                  Firebaseへの接続に失敗しました
                </p>

                <p class="text-stone-400 text-[10px] mt-2">
                  ページを再読み込みしてください
                </p>
              </div>
            `;
          }
        }
      };


    onAuthStateChanged(
      auth,
      user => {

        if (user) {

          startSubscriptions();

        }
      }
    );


    /*
     * 万一onSnapshotの応答が遅い場合でも
     * ローディング画面を永久表示させない
     */
    setTimeout(
      () => {

        hideLoading();

      },
      5000
    );


    init();

  </script>

</body>
</html>
