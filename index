  <script type="module">

    /* =========================================================
       Firebase
    ========================================================= */

    import {
      initializeApp
    } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";


    import {
      getAuth,
      signInAnonymously,
      onAuthStateChanged,
      setPersistence,
      browserLocalPersistence
    } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";


    import {
      getFirestore,
      collection,
      addDoc,
      onSnapshot,
      updateDoc,
      doc,
      deleteDoc,
      writeBatch
    } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";


    import {
      getStorage,
      ref,
      uploadBytes,
      getDownloadURL,
      deleteObject
    } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-storage.js";


    /* =========================================================
       Firebase設定
       前回の家計簿と同じプロジェクト
    ========================================================= */

    const firebaseConfig = {

      apiKey:
        "AIzaSyBnc3RBpaLeXBninYx9dXAAKBLvVenFK3I",

      authDomain:
        "kakeibo-e13ee.firebaseapp.com",

      projectId:
        "kakeibo-e13ee",

      storageBucket:
        "kakeibo-e13ee.firebasestorage.app",

      messagingSenderId:
        "826192711708",

      appId:
        "1:826192711708:web:0fd72a0d74158055620fd9"

    };


    const app =
      initializeApp(
        firebaseConfig
      );


    const auth =
      getAuth(
        app
      );


    const db =
      getFirestore(
        app
      );


    const storage =
      getStorage(
        app
      );


    /* =========================================================
       共有ID
    ========================================================= */

    let shareId =
      new URLSearchParams(
        window.location.search
      ).get('uid');


    if (!shareId) {

      shareId =
        'fam_' +
        crypto
          .randomUUID()
          .replaceAll('-', '')
          .slice(0, 20);


      const newUrl =
        window.location.protocol +
        "//" +
        window.location.host +
        window.location.pathname +
        '?uid=' +
        encodeURIComponent(
          shareId
        );


      window.history.replaceState(
        {},
        '',
        newUrl
      );
    }


    /* =========================================================
       localStorage
       共有IDごとに選択メンバーを保存
    ========================================================= */

    const memberStorageKey =
      `family_shopping_selected_member_${shareId}`;


    let selectedMemberId =
      localStorage.getItem(
        memberStorageKey
      ) || null;


    /* =========================================================
       定数
    ========================================================= */

    const COLOR_PRESETS = [

      {
        name: 'ストーン',
        bg: 'bg-stone-100',
        text: 'text-stone-600'
      },

      {
        name: 'セージ',
        bg: 'bg-emerald-50',
        text: 'text-emerald-700'
      },

      {
        name: 'テラコッタ',
        bg: 'bg-orange-50',
        text: 'text-orange-700'
      },

      {
        name: 'ラベンダー',
        bg: 'bg-purple-50',
        text: 'text-purple-700'
      },

      {
        name: 'サンド',
        bg: 'bg-amber-50',
        text: 'text-amber-800'
      },

      {
        name: 'スレート',
        bg: 'bg-sky-50',
        text: 'text-sky-700'
      }

    ];


    let selectedColorIndex = 0;

    let currentItems = [];
    let currentMembers = [];

    let currentImageBlob = null;
    let currentImagePreviewUrl = null;

    let unsubscribeItems = null;
    let unsubscribeMembers = null;

    let isMembersLoaded = false;
    let isItemsLoaded = false;

    let confirmAction = null;


    /* =========================================================
       Firestoreパス
    ========================================================= */

    const getListCol =
      () =>
        collection(
          db,
          'shopping_lists',
          shareId,
          'items'
        );


    const getMembersCol =
      () =>
        collection(
          db,
          'shopping_lists',
          shareId,
          'members'
        );


    const getListItemDoc =
      id =>
        doc(
          db,
          'shopping_lists',
          shareId,
          'items',
          id
        );


    const getMemberDoc =
      id =>
        doc(
          db,
          'shopping_lists',
          shareId,
          'members',
          id
        );


    /* =========================================================
       ズーム防止
    ========================================================= */

    document.addEventListener(
      'gesturestart',
      event => {
        event.preventDefault();
      },
      {
        passive: false
      }
    );


    document.addEventListener(
      'gesturechange',
      event => {
        event.preventDefault();
      },
      {
        passive: false
      }
    );


    document.addEventListener(
      'gestureend',
      event => {
        event.preventDefault();
      },
      {
        passive: false
      }
    );


    let lastTouchEnd = 0;


    document.addEventListener(
      'touchend',
      event => {

        const now =
          Date.now();


        if (
          now - lastTouchEnd <= 300
        ) {
          event.preventDefault();
        }


        lastTouchEnd =
          now;
      },
      {
        passive: false
      }
    );


    document.addEventListener(
      'dblclick',
      event => {
        event.preventDefault();
      },
      {
        passive: false
      }
    );


    /* =========================================================
       Toast
    ========================================================= */

    let toastTimer = null;


    const showToast =
      msg => {

        const toast =
          document.getElementById(
            'toast'
          );


        if (toastTimer) {
          clearTimeout(
            toastTimer
          );
        }


        toast.textContent =
          msg;


        toast.classList.remove(
          'hidden'
        );


        toastTimer =
          setTimeout(
            () => {

              toast.classList.add(
                'hidden'
              );

            },
            3000
          );
      };


    /* =========================================================
       Escape
    ========================================================= */

    const escapeHtml =
      value => {

        if (
          value === null ||
          value === undefined
        ) {
          return '';
        }


        return String(value)
          .replace(
            /[&<>'"]/g,
            tag => ({
              '&': '&amp;',
              '<': '&lt;',
              '>': '&gt;',
              "'": '&#39;',
              '"': '&quot;'
            }[tag])
          );
      };


    /* =========================================================
       日付
    ========================================================= */

    const formatDate =
      timestamp => {

        if (!timestamp) {
          return '';
        }


        const date =
          new Date(
            timestamp
          );


        const m =
          date.getMonth() + 1;


        const d =
          date.getDate();


        const h =
          String(
            date.getHours()
          ).padStart(
            2,
            '0'
          );


        const min =
          String(
            date.getMinutes()
          ).padStart(
            2,
            '0'
          );


        return `${m}/${d} ${h}:${min}`;
      };


    /* =========================================================
       Confirm
    ========================================================= */

    const showConfirm =
      (
        message,
        onOk
      ) => {

        document
          .getElementById(
            'confirm-message'
          )
          .textContent =
          message;


        confirmAction =
          onOk;


        document
          .getElementById(
            'confirm-modal'
          )
          .classList
          .remove(
            'hidden'
          );
      };


    document
      .getElementById(
        'confirm-cancel'
      )
      .onclick =
      () => {

        confirmAction =
          null;

        document
          .getElementById(
            'confirm-modal'
          )
          .classList
          .add(
            'hidden'
          );
      };


    document
      .getElementById(
        'confirm-ok'
      )
      .onclick =
      async () => {

        const action =
          confirmAction;


        confirmAction =
          null;


