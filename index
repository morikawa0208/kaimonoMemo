        const targetIndex =
          direction === 'up'
            ? index - 1
            : index + 1;


        if (
          targetIndex < 0 ||
          targetIndex >=
            sorted.length
        ) {
          return;
        }


        [
          sorted[index],
          sorted[targetIndex]
        ] = [
          sorted[targetIndex],
          sorted[index]
